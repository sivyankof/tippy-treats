# Copy to .env and fill in. Never commit .env (docs/11a-device-build.md, section 6).
# AdMob: the app ids go into the native projects through scripts/native/native-ids.cjs; the ad units
# are used only by the store build. The dev server and the internal build always run on Google's
# sample ids. A blank value: Google's sample app id, and no ads at all in the store build.
# RevenueCat: the public SDK keys (appl_..., goog_...); blank keeps the purchases unavailable.
# Firebase needs no line here: its settings files sit in the native projects (git-ignored).

VITE_ADMOB_APP_ID_IOS=
VITE_ADMOB_REWARDED_ID_IOS=
VITE_ADMOB_INTERSTITIAL_ID_IOS=
VITE_ADMOB_APP_ID_ANDROID=
VITE_ADMOB_REWARDED_ID_ANDROID=
VITE_ADMOB_INTERSTITIAL_ID_ANDROID=

VITE_REVENUECAT_API_KEY_IOS=
VITE_REVENUECAT_API_KEY_ANDROID=

# Store product ids of the purchases (docs/05-economy-monetization.md, section 5). A product with
# a blank id is shown as unavailable. In the browser the purchase stub sells whatever has an id here.
# The ids carry the game prefix `tippy_`: an App Store product id is unique across the whole
# developer account, and the account will hold other games. App Store Connect has them as below.
VITE_IAP_REMOVE_ADS=tippy_remove_ads
VITE_IAP_STARTER_PACK=tippy_starter_pack
VITE_IAP_BERRIES_80=tippy_berries_80
VITE_IAP_BERRIES_500=tippy_berries_500
VITE_IAP_BERRIES_1200=tippy_berries_1200
VITE_IAP_BERRIES_2800=tippy_berries_2800
