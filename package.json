{
  "name": "tippy-treats",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:internal": "tsc --noEmit && vite build --mode internal",
    "app:sync": "npm run build && node scripts/native/native-ids.cjs && cap sync",
    "app:sync:internal": "npm run build:internal && node scripts/native/native-ids.cjs --internal && cap sync",
    "preview": "vite preview",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "soak:auto": "node scripts/soak-auto.cjs",
    "store:shots": "tsx scripts/store/store-shots.ts",
    "sim": "tsx scripts/sim.ts",
    "sim:strong": "tsx scripts/strong-fit.ts",
    "sim:coins": "tsx scripts/coin-sources.ts",
    "sim:speed": "tsx scripts/speed-curve.ts",
    "sim:speed-variants": "tsx scripts/speed-variants.ts",
    "sim:economy": "tsx scripts/economy-model.ts",
    "sim:teams": "tsx scripts/team-sweep.ts",
    "sim:first40": "tsx scripts/first-layers.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@capacitor-community/admob": "8.2.1",
    "@capacitor-community/in-app-review": "8.0.0",
    "@capacitor-firebase/analytics": "8.6.0",
    "@capacitor-firebase/crashlytics": "8.6.0",
    "@capacitor/android": "8.6.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.2",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.6.2",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/splash-screen": "8.0.2",
    "@revenuecat/purchases-capacitor": "14.1.2",
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
